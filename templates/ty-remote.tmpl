#!/usr/bin/env bash
# ty-remote — Run TaskYou commands on your server (or this machine in local mode)
# Usage: ./bin/ty-remote <command> [args...]
#   e.g., ./bin/ty-remote list
#         ./bin/ty-remote create "My task" --project myproject

set -euo pipefail

if [ $# -eq 0 ]; then
  echo "Usage: ./bin/ty-remote <command> [args...]"
  echo "Example: ./bin/ty-remote list"
  exit 1
fi

SERVER_HOST="{{SERVER_HOST}}"
SERVER_HOME="{{SERVER_HOME}}"

if [[ "$SERVER_HOST" == "local" || "$SERVER_HOST" == "localhost" || -z "$SERVER_HOST" ]]; then
  # Local mode: the daemon runs on this machine — run ty directly, no SSH.
  export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
  cd "$SERVER_HOME" && exec ty "$@"
else
  # Shell-quote every argument for the REMOTE shell.
  #
  # ssh does not accept an argv — it accepts ONE command string, which the
  # remote login shell re-parses. So "$*" (and even "$@") loses argument
  # boundaries on that round trip: every argument containing whitespace is
  # word-split again on the far side. Concretely,
  #
  #   ty-remote create "My task title" --project engineering --body "Some text"
  #
  # reached the remote `ty` as ~8 separate arguments and was rejected with
  # "Error: accepts at most 1 arg(s), received 8". Single-word commands (list,
  # execute 179, close 179) were unaffected, which is why this went unnoticed.
  #
  # printf '%q' quotes each argument so it survives the remote re-parse as a
  # single argument, apostrophes and quotes included. (printf rather than bash
  # 4.4's ${@@Q}, so this still works on macOS's stock bash 3.2.)
  remote_args=""
  for arg in "$@"; do
    remote_args="$remote_args $(printf '%q' "$arg")"
  done

  ssh "$SERVER_HOST" "export NVM_DIR=\"\$HOME/.nvm\" && [ -s \"\$NVM_DIR/nvm.sh\" ] && . \"\$NVM_DIR/nvm.sh\" && export PATH=\"$SERVER_HOME/.local/bin:$SERVER_HOME/bin:$SERVER_HOME/.npm-global/bin:\$PATH\" && cd $SERVER_HOME && ty$remote_args"
fi
